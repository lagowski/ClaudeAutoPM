{
  "name": "claude-autopm",
  "version": "4.0.0",
  "description": "Autonomous Project Management Framework for Claude Code - Advanced AI-powered development automation",
  "main": "bin/autopm.js",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "autopm": "./bin/autopm.js"
  },
  "scripts": {
    "postinstall": "echo '🎉 ClaudeAutoPM installed! Run: autopm --help'",
    "sync:commands": "node scripts/sync-plugin-commands.js",
    "sync:commands:check": "node scripts/sync-plugin-commands.js --check",
    "sync:scripts": "node scripts/sync-plugin-scripts.js",
    "sync:scripts:check": "node scripts/sync-plugin-scripts.js --check",
    "test": "jest",
    "posttest": "npm run test:security && npm run test:regression && npm run test:cli",
    "test:quick": "jest --config jest.config.quick.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest --testMatch '<rootDir>/test/security/**/*.test.js'",
    "test:regression": "jest --runInBand --testMatch '<rootDir>/test/regression/**/*.test.js'",
    "test:cli": "jest --testMatch '<rootDir>/test/cli/**/*.test.js'",
    "test:install": "jest --runInBand --testMatch '<rootDir>/test/installation/{e2e-scenarios,generate-agent-xml,package-based-install}.test.js'",
    "migration:tdd": "node scripts/migration/tdd-migrate.js",
    "migration:next": "node scripts/migration/tdd-migrate.js next",
    "migration:test": "jest --testMatch '<rootDir>/test/node-scripts/**/*.test.js'",
    "migration:status": "node scripts/migration/tdd-migrate.js status",
    "migration:report": "node scripts/migration/tdd-migrate.js report",
    "lint": "npm run lint:md && npm run lint:js",
    "lint:md": "markdownlint *.md .claude/**/*.md install/*.md",
    "lint:js": "eslint bin lib scripts test",
    "lint:fix": "markdownlint --fix *.md .claude/**/*.md install/*.md && eslint --fix bin lib scripts test",
    "format": "prettier --write *.md .claude/**/*.md install/*.md",
    "validate": "npm run lint && npm run test",
    "prepublishOnly": "echo 'Skipping validation for first publish'",
    "pm:maintain": "node scripts/self-maintenance.js all",
    "pm:validate": "node scripts/self-maintenance.js validate",
    "pm:test": "node scripts/self-maintenance.js test",
    "pm:metrics": "node scripts/self-maintenance.js metrics",
    "pm:optimize": "node scripts/self-maintenance.js optimize",
    "pm:health": "node scripts/self-maintenance.js health",
    "validate:paths": "bash scripts/validate-framework-paths.sh",
    "setup:githooks": "bash scripts/setup-githooks.sh"
  },
  "keywords": [
    "ai",
    "automation",
    "claude",
    "claude-code",
    "project-management",
    "development-tools",
    "devops",
    "ci-cd",
    "github-actions",
    "azure-devops",
    "mcp",
    "model-context-protocol",
    "tdd",
    "agents",
    "workflow",
    "productivity"
  ],
  "author": {
    "name": "ClaudeAutoPM Team",
    "email": "autopm@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafeekpro/ClaudeAutoPM.git"
  },
  "homepage": "https://github.com/rafeekpro/ClaudeAutoPM#readme",
  "bugs": {
    "url": "https://github.com/rafeekpro/ClaudeAutoPM/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "preferGlobal": true,
  "files": [
    "bin/",
    "lib/",
    "autopm/",
    "packages/",
    ".github/",
    "scripts/",
    "install/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.0",
    "azure-devops-node-api": "^17.0.0",
    "chalk": "4.1.2",
    "dotenv": "^18.0.2",
    "fs-extra": "^11.3.2",
    "glob": "^14.0.3",
    "inquirer": "^14.0.2",
    "js-yaml": "^4.1.0",
    "markdown-it": "^15.0.0",
    "ora": "~5.4.1",
    "yaml": "^2.8.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.1.2",
    "@types/jest": "^30.0.0",
    "axios": "^1.12.2",
    "eslint": "^10.6.0",
    "globals": "^17.6.0",
    "jest": "^30.1.3",
    "jest-diff": "^30.1.2",
    "jest-extended": "^7.0.0",
    "jest-html-reporter": "^4.3.0",
    "jest-junit": "^17.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "markdownlint-cli": "^0.50.0",
    "nock": "^15.0.1",
    "prettier": "^3.0.0"
  },
  "optionalDependencies": {
    "@playwright/mcp": "^0.0.86",
    "@upstash/context7-mcp": "^4.0.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rla"
  },
  "config": {
    "autopm": {
      "defaultTemplate": "https://github.com/rafeekpro/ClaudeAutoPM.git",
      "configDir": ".claude",
      "envFile": ".claude/.env"
    }
  }
}
